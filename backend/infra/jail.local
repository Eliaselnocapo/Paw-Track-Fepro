[DEFAULT]
# Protege a todos por igual
bantime  = 3600
findtime = 600
maxretry = 5
estemail = alertasmantenimientopawtrack@gmail.com
# Quién lo envía
sender = alertas.mantenimiento.pawtrack@gmail.com
# Usar mta (Mail Transfer Agent) configurado, que en tu caso es msmtp
mta = sendmail
# Acción: banear y enviar un correo con información detallada
action = %(action_mwl)s


[nginx-404-generic]
enabled  = true
port     = http,https
filter   = nginx-404-generic
logpath  = /opt/pawtrack/backend/nginx/logs/access.log
maxretry = 10
banaction = iptables-multiport
chain     = DOCKER-USER
# Aumenté a 10 porque 4 es muy poco y podrías bloquearte a ti mismo

[nginx-botsearch]
enabled  = true
port     = http,https
filter   = nginx-botsearch
logpath  = /opt/pawtrack/backend/nginx/logs/access.log
maxretry = 2
bantime  = 86400
banaction = iptables-multiport
chain     = DOCKER-USER
# Este es brutal contra atacantes que buscan paneles admin o archivos ocultos

[nginx-http-auth]
enabled  = false
port     = http,https
filter   = nginx-http-auth
logpath  = /opt/pawtrack/backend/nginx/logs/error.log
maxretry = 3
# Protege tu login de Django contra ataques de fuerza bruta
[sshd]
enabled = true

