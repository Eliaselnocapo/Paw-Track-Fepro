IMAGEN_PRUEBA = "C:\\Users\\manue\\Downloads\\perro_imagen.jpg"

def preparar_base_datos():
    """Crea una tabla temporal y la llena con 10,000 hashes falsos súper rápido."""
    try:
        conn = psycopg2.connect(**DB_CONFIG)
        cur = conn.cursor()
        
        print("Preparando tabla PostgreSQL temporal...")
        cur.execute("DROP TABLE IF EXISTS simulacion_hashes;")
        cur.execute("""
            CREATE TABLE simulacion_hashes (
                id SERIAL PRIMARY KEY,
                hash_estructural BIGINT
            );
        """)
        
        print("Insertando 10,000 registros aleatorios (Bulk Insert)...")
        # Generar enteros de 64 bits con signo (BIGINT de Postgres va de -9223372036854775808 a 9223372036854775807)
        datos = [(random.randint(-9223372036854775808, 9223372036854775807),) for _ in range(10000)]
        
        execute_values(cur, "INSERT INTO simulacion_hashes (hash_estructural) VALUES %s", datos, page_size=1000)
        conn.commit()
        
        # Crear un índice (aunque para XOR bit a bit en toda la tabla, Postgres hará un Seq Scan)
        cur.execute("CREATE INDEX idx_hash ON simulacion_hashes(hash_estructural);")
        conn.commit()
        
        return conn
    except Exception as e:
        print(f"Error conectando a la BD: {e}")
        return None

# ==========================================
# 2. EJECUCIÓN DEL PIPELINE
# ==========================================
def ejecutar_pipeline_real(conn):
    tracemalloc.start()
    t_inicio_total = time.perf_counter()

    try:
        imagen = Image.open(IMAGEN_PRUEBA).convert('RGB')
    except FileNotFoundError:
        print(f"Error: No se encontró la imagen {IMAGEN_PRUEBA}")
        return

    # --- ETAPA A: Conversión Inicial (pHash) ---
    t0 = time.perf_counter()
    hash_hex = str(imagehash.phash(imagen))
    
    # Convertir hexadecimal a entero con signo de 64 bits para que empate con BIGINT de Postgres
    hash_int = int(hash_hex, 16)
    if hash_int > 9223372036854775807:
        hash_int -= 18446744073709551616 
        
    t_hash = time.perf_counter() - t0

    # --- ETAPA B: Consulta SQL Directa ---
    # Usamos bit_count y XOR nativo de Postgres 15 para delegar la carga matemática al motor
    t0 = time.perf_counter()
    cur = conn.cursor()
    query = """
        SELECT id, hash_estructural, 
               bit_count((hash_estructural # %s)::bit(64)) AS distancia_hamming
        FROM simulacion_hashes
        ORDER BY distancia_hamming ASC
        LIMIT 5;
    """
    cur.execute(query, (hash_int,))
    resultados_db = cur.fetchall()
    t_db = time.perf_counter() - t0

    # --- ETAPA C: Validación con Red Neuronal (MobileNetV2) ---
    t0 = time.perf_counter()
    
    input_tensor = preprocess(imagen).unsqueeze(0)
    
    with torch.no_grad():
        vector_original = modelo_nn(input_tensor)
        batch_candidatas = torch.randn(5, 3, 224, 224)
        vectores_candidatos = modelo_nn(batch_candidatas)
        
        similitud = torch.nn.functional.cosine_similarity(vector_original, vectores_candidatos)

    t_nn = time.perf_counter() - t0
    t_fin_total = time.perf_counter() - t_inicio_total

    _, ram_pico = tracemalloc.get_traced_memory()
    tracemalloc.stop()

    print("\n" + "="*40)
    print("🚀 RESULTADOS (DB REAL + RED NEURONAL)")
    print("="*40)
    print(f"Etapa A (Hash Python):    {t_hash*1000:.2f} ms")
    print(f"Etapa B (Query Postgres): {t_db*1000:.2f} ms")
    print(f"Etapa C (MobileNetV2):    {t_nn*1000:.2f} ms")
    print("-" * 40)
    print(f"⏱️ TIEMPO TOTAL:          {t_fin_total*1000:.2f} ms ({t_fin_total:.3f} segundos)")
    print(f"💾 PICO DE RAM:           {ram_pico / (1024*1024):.2f} MB")
    print("="*40)

if __name__ == "__main__":
    conexion = preparar_base_datos()
    if conexion:
        ejecutar_pipeline_real(conexion)
        conexion.close()